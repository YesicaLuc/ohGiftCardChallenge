{
  "name": "qa_automation_challenge",
  "version": "1.0.0",
  "description": "Suite de pruebas automatizadas (API Petstore y UI Buggy Cars) con Cypress y TypeScript",
  "private": true,
  "engines": {
    "node": "^22 || ^24 || >=26"
  },
  "scripts": {
    "test:api": "cypress run --spec 'cypress/e2e/api/**/*.cy.ts' --expose grepTags=-@known-bug",
    "test:ui": "cypress run --spec 'cypress/e2e/ui/**/*.cy.ts' --expose grepTags=-@known-bug",
    "test": "cypress run --expose grepTags=-@known-bug",
    "test:known-bugs": "cypress run --expose grepTags=@known-bug,grepFilterSpecs=true,grepOmitFiltered=true",
    "test:postman": "newman run postman/petstore.postman_collection.json -e postman/petstore.postman_environment.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "ISC",
  "devDependencies": {
    "@cypress/grep": "^7.0.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^26.6.6",
    "cypress": "^16.2.1",
    "cypress-mochawesome-reporter": "^5.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.4",
    "newman": "^6.2.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "zod": "^4.6.7"
  }
}
